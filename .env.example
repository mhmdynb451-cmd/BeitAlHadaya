# Copy to .env and fill in. NEVER commit real keys. All values are read via
# process.env.EXPO_PUBLIC_* at build time — no secrets are hardcoded in source.
#
# Supabase (optional). If omitted, the app runs in local demo mode.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
#
# Optional: AI provider key for the support agent (server-side proxy recommended).
EXPO_PUBLIC_AI_API_KEY=
